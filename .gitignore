# Python and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
.venv/
venv/
*.egg-info/

# Secrets: API keys live in the environment, never in the tree
.env
.env.*
*.key
*.pem

# Run stores and raw data (too large for git; hashes are in results/EVIDENCE_MANIFEST.json)
*.duckdb
*.duckdb.wal
*.parquet
*.zip

# Logs and console captures
*.log
*_stdout.log

# Generated campaign outputs: final evidence, rehearsals, smoke tests, legacy runs
results/final_*/
results/rehearsal/
results/legacy*/
results/*smoke*
results/package/

# Scratch notebooks
*.ipynb
.ipynb_checkpoints/
scratch/

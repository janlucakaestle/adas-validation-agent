  "regenerate": {
    "note": "Needs a clean, committed tree of this repository, the exact environment in requirements-lock.txt and ANTHROPIC_API_KEY for the agent seeds. Outputs go to results/final_<release-id prefix>/.",
    "commands": [
      "python -m avval.cli --final release",
      "python -m avval.cli --final characterise",
      "python -m avval.cli --final estimate --n 100000 --seed 0",
      "python -m avval.cli --final benchmark-freeze",
      "python -m avval.cli --final benchmark-run --strategy <random|grid|boundary|evolutionary|cem|bayesopt>",
      "python -m avval.cli --final agent --first-seed 0 --seeds 10",
      "python -m avval.cli --final benchmark-report",
      "python -m avval.cli --final sensitivity-freeze",
      "python -m avval.cli --final sensitivity --design <oat|factorial2|lhs>",
      "python -m avval.cli --final reference-boxes estimate",
      "python -m avval.cli --final freeze-predicates --from-benchmark",
      "python -m avval.cli --final holdout-freeze --n 100000 --seed 4242",
      "python -m avval.cli --final holdout-run",
      "python -m avval.cli --final holdout-report",
      "python -m avval.cli --final diagnose estimate",
      "python -m avval.cli --final findings --estimation estimate --from-benchmark",
      "python -m avval.cli --final report estimate",
      "python -m avval.cli --final package",
      "python -m avval.cli verify-package results/final_<id>/package"
    ]
  }
